# =============================================================
# DentalERP Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================

# ── Database (MySQL) ──────────────────────────────────────────
# Replace 'root' and 'password' with your MySQL credentials.
# Using docker-compose.dev.yml? These defaults match its isolated host ports.
DATABASE_URL="mysql://root:dental@localhost:13306/dental_erp"

# ── FastAPI backend (PostgreSQL) ──────────────────────────────
# Prefixed so the Python backend cannot accidentally consume the legacy MySQL URL.
BACKEND_DATABASE_URL="postgresql+asyncpg://dental:dental@localhost:15432/dental_erp"
BACKEND_JWT_SECRET="replace-with-at-least-32-random-characters"
BACKEND_CORS_ORIGINS="http://localhost:3000"

# Where Next.js reaches the backend. Containerised backend published on
# loopback by docker-compose.dev.yml; use http://backend:8000 if the Next.js
# app itself is running inside the same compose network.
FASTAPI_URL="http://127.0.0.1:18000"

# ── Docker development ports ─────────────────────────────────
# Project-specific defaults avoid the ports most other stacks use. Compose
# binds them to 127.0.0.1, so the backing services are not LAN-accessible.
DENTAL_ERP_DEV_MYSQL_PORT="13306"
DENTAL_ERP_DEV_POSTGRES_PORT="15432"
DENTAL_ERP_DEV_BACKEND_PORT="18000"
DENTAL_ERP_DEV_REDIS_PORT="16379"
DENTAL_ERP_DEV_MINIO_PORT="19000"
DENTAL_ERP_DEV_MINIO_CONSOLE_PORT="19001"
DENTAL_ERP_DEV_SMTP_PORT="11025"
DENTAL_ERP_DEV_MAILPIT_UI_PORT="18025"

# ── NextAuth ──────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# ── File Storage ──────────────────────────────────────────────
# "local" (default) or "s3". Local disk is correct for a single instance and
# needs nothing else running. See docs/STORAGE.md for how to choose, and for
# the one-command migration between them.
STORAGE_DRIVER="local"
# Where the local driver keeps files. Relative paths resolve against the
# application directory.
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760"

# ── Object Storage (S3-compatible) — Optional ───────────────────
# Only read when STORAGE_DRIVER="s3". Works against MinIO, AWS S3, Cloudflare
# R2, DigitalOcean Spaces and anything else speaking the same API.
#
# Setting these alone changes nothing: the driver switch is STORAGE_DRIVER, and
# it is separate on purpose, because your existing files do not move on their
# own. Copy them across first — `npm run storage:migrate -- --dry-run`.
#
# The values below match docker-compose.dev.yml.
# S3_ENDPOINT="http://localhost:19000"
# S3_ACCESS_KEY="dentalerp"
# S3_SECRET_KEY="dentalerp123"
# S3_BUCKET="dental-erp-uploads"
# S3_REGION="us-east-1"
# MinIO and most non-AWS S3 implementations need path-style addressing
# S3_FORCE_PATH_STYLE="true"

# ── Cache / Queue (Redis) — Optional, not yet wired up ──────────
# Leave unset and caching and rate limiting stay in-process, which is correct
# for a single instance. Set it once you run more than one.
# REDIS_URL="redis://localhost:16379"

# ── Application ───────────────────────────────────────────────
NODE_ENV="development"

# ── Payment Gateway Encryption (REQUIRED) ─────────────────────
# AES-256-GCM needs a 64-character hex string (32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# ── Cron Jobs Security (REQUIRED) ────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
CRON_SECRET=""

# ── AI (OpenRouter) — Optional ────────────────────────────────
# Sign up at https://openrouter.ai to get an API key
# Required only for AI features (treatment advisor, smart scheduler, etc.)
OPENROUTER_API_KEY=""

# ── Email (SMTP) — Optional ──────────────────────────────────
# Required for email notifications, password reset, etc.
#
# For local development use Mailpit from docker-compose.dev.yml. It accepts
# every message, delivers none of them, and shows you the result at
# http://localhost:18025 — so you can exercise the email paths with no
# credentials and no chance of mailing a real patient:
#   SMTP_HOST="localhost"
#   SMTP_PORT="11025"
#   SMTP_SECURE="false"
#   SMTP_USER=""
#   SMTP_PASSWORD=""
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""

# ── SMS Gateway — Optional ───────────────────────────────────
# Required for SMS appointment reminders
SMS_API_KEY=""
SMS_SENDER_ID="DENTAL"

# ── Video Consultation — Optional ─────────────────────────────
# Jitsi Meet (free, no API key needed)
JITSI_DOMAIN="meet.jit.si"
# Or use Daily.co (requires API key):
# DAILY_API_KEY=""
# DAILY_DOMAIN="your-domain.daily.co"

# ── Product tier ─────────────────────────────────────────────
# Product tier: "full" (website + ERP) or "landing" (website only).
# Defaults to "full" when unset.
PRODUCT_TIER=full

# Selects the per-client website content at config/sites/<SITE_ID>.json.
SITE_ID=default

# Base URL used to build absolute URLs in sitemap.xml and robots.txt.
# Defaults to "http://localhost:3000" when unset — fine for local development,
# but leaving it unset in a real deployment publishes localhost URLs in both
# files. Set it to the site's real public URL.
# SITE_URL="https://www.example-clinic.et"
