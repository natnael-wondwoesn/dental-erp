# =============================================================
# DentalERP — VPS production environment for compose.vps.yml
#
#   cp .env.production.example .env
#   chmod 600 .env
#   docker compose -f compose.vps.yml --env-file .env up -d --build
#
# This deployment expects a global Caddy on the shared `kora_default` network.
# Only the `dental-web` container joins that network; databases and the FastAPI
# backend remain private on the project-internal network.
# =============================================================

# ── Product Tier ──────────────────────────────────────────────
PRODUCT_TIER="landing"

# ── Frontend Database (MySQL / Prisma) ───────────────────────
MYSQL_ROOT_PASSWORD=""
MYSQL_DATABASE="dental_erp"
MYSQL_USER="dental_user"
MYSQL_PASSWORD=""
MYSQL_MAX_CONNECTIONS="151"
DATABASE_URL="mysql://dental_user:replace-me@dental-mysql:3306/dental_erp"

# ── Backend Database (PostgreSQL / FastAPI) ──────────────────
POSTGRES_DB="dental_erp"
POSTGRES_USER="dental_user"
POSTGRES_PASSWORD=""
BACKEND_DATABASE_URL="postgresql+asyncpg://dental_user:replace-me@dental-postgres:5432/dental_erp"

# ── Backend API ───────────────────────────────────────────────
FASTAPI_URL="http://dental-backend:8000"
BACKEND_ENVIRONMENT="production"
BACKEND_JWT_SECRET=""
BACKEND_CORS_ORIGINS="https://dental-clinic-cms.duckdns.org"

# ── NextAuth ──────────────────────────────────────────────────
NEXTAUTH_URL="https://dental-clinic-cms.duckdns.org"
NEXTAUTH_SECRET=""

# ── Application ───────────────────────────────────────────────
NODE_ENV="production"

# ── File Storage ──────────────────────────────────────────────
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760"

# ── Security ──────────────────────────────────────────────────
ENCRYPTION_KEY=""
CRON_SECRET=""

# ── Optional Integrations ─────────────────────────────────────
OPENROUTER_API_KEY=""
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMS_API_KEY=""
SMS_SENDER_ID="DENTAL"
JITSI_DOMAIN="meet.jit.si"
